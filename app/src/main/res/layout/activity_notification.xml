<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/notification_background">

    <!-- 「通知一覧」という画面タイトル -->
    <TextView
        android:id="@+id/tvNotificationScreenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="通知一覧"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        「あなたへの回答」と
        「ベストアンサー通知」を横に並べる箱
    -->
    <LinearLayout
        android:id="@+id/notificationTabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvNotificationScreenTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 選択中のタブ -->
        <TextView
            android:id="@+id/tvAnswerNotificationTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/notification_tab_active"
            android:gravity="center"
            android:padding="12dp"
            android:text="あなたへの回答"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- 選択されていないタブ -->
        <TextView
            android:id="@+id/tvBestAnswerNotificationTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/notification_tab_inactive"
            android:gravity="center"
            android:padding="12dp"
            android:text="ベストアンサー通知"
            android:textColor="@color/black"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- 質問の通知を並べる場所 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/notificationList"
        android:layout_width="348dp"
        android:layout_height="516dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.483"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.59" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".views.AddQuestionFragment">

    <LinearLayout
        android:id="@+id/QuestionLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="50dp"
        android:paddingTop="50dp"
        android:paddingRight="50dp">

        <LinearLayout
            android:id="@+id/TitleLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/TitleEditText"
                android:layout_width="90dp"
                android:layout_height="match_parent"
                android:background="#EDE7F6"
                android:gravity="center_vertical|start"
                android:layout_marginTop="16dp"
                android:text="　タイトル："
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.486"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.217" />

            <EditText
                android:id="@+id/TitleText"
                android:layout_width="225dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="#EDE7F6"
                android:gravity="center_vertical|start"
                android:hint=" タイトルを入力"
                android:maxLength="36"
                android:scrollbars="vertical"
                android:overScrollMode="ifContentScrolls"
                android:nestedScrollingEnabled="true"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="312dp"
            android:layout_height="230dp"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="#EDE7F6"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="質問："
                android:textSize="16sp" />

            <EditText
                android:id="@+id/QuestionText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="top|start"
                android:background="@null"
                android:padding="4dp"
                android:hint="質問を入力してください"
                android:textSize="16sp"
                android:inputType="textMultiLine|textCapSentences"
                android:singleLine="false"
                android:scrollHorizontally="false"
                android:breakStrategy="simple" />

        </LinearLayout>

        <TextView
            android:id="@+id/CreatePlaceText"
            android:layout_width="312dp"
            android:layout_height="130dp"
            android:layout_marginTop="16dp"
            android:background="#EDE7F6"
            android:paddingTop="8dp" />

        <LinearLayout
            android:id="@+id/ViewerLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView6"
                android:layout_width="123dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="#EDE7F6"
                android:gravity="center_vertical|start"
                android:text="　閲覧者制限：" />

            <Spinner
                android:id="@+id/ViewerSpinner"
                android:layout_width="189dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/spinner_fragment_background" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/AnswerLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView7"
                android:layout_width="123dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="#EDE7F6"
                android:gravity="center_vertical|start"
                android:text="　回答者制限：" />

            <Spinner
                android:id="@+id/AnswerSpinner"
                android:layout_width="189dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/spinner_fragment_background" />


        </LinearLayout>

    <LinearLayout
        android:id="@+id/TagLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/Tag"
            android:layout_width="123dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="#EDE7F6"
            android:gravity="center_vertical|start"
            android:text="　タグ：" />

        <TextView
            android:id="@+id/TagText"
            android:layout_width="189dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="#EDE7F6"
            android:gravity="center_vertical|start" />

    </LinearLayout>

        <TextView
            android:id="@+id/NextButton"
            android:layout_width="114dp"
            android:layout_height="52dp"
            android:background="#FFBBC6"
            android:gravity="center"
            android:text="公開する"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.882"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.887"
            android:layout_gravity="end"/>



    </LinearLayout>

</ScrollView>
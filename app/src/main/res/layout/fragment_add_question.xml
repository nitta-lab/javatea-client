<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".views.AddQuestionFragment">

    <LinearLayout
        android:id="@+id/QuestionLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="50dp"
        android:paddingTop="50dp"
        android:paddingRight="50dp">

        <EditText
            android:id="@+id/TitleText"
            android:layout_width="336dp"
            android:layout_height="56dp"
            android:background="#EDE7F6"
            android:gravity="center_vertical|start"
            android:text="　タイトル："
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.486"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.217" />


        <EditText
            android:id="@+id/QuestionText"
            android:layout_width="336dp"
            android:layout_height="230dp"
            android:background="#EDE7F6"
            android:gravity="top|left"
            android:paddingTop="10dp"
            android:text="　Question："
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/CreatePlaceText"
            android:layout_width="336dp"
            android:layout_height="130dp"
            android:layout_marginTop="16dp"
            android:background="#EDE7F6"
            android:paddingTop="8dp" />

        <LinearLayout
            android:id="@+id/ViewerLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView6"
                android:layout_width="135dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="#EDE7F6"
                android:gravity="center_vertical|start"
                android:text="　閲覧者制限：" />

            <Spinner
                android:id="@+id/ViewerSpinner"
                android:layout_width="201dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/spinner_fragment_background" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/AnswerLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView7"
                android:layout_width="135dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="#EDE7F6"
                android:gravity="center_vertical|start"
                android:text="　回答者制限：" />

            <Spinner
                android:id="@+id/AnswerSpinner"
                android:layout_width="201dp"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/spinner_fragment_background" />


        </LinearLayout>

    <LinearLayout
        android:id="@+id/TagLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/Tag"
            android:layout_width="135dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="#EDE7F6"
            android:gravity="center_vertical|start"
            android:text="　タグ：" />

        <TextView
            android:id="@+id/TagText"
            android:layout_width="201dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="#EDE7F6"
            android:gravity="center_vertical|start" />

    </LinearLayout>

        <TextView
            android:id="@+id/NextButton"
            android:layout_width="114dp"
            android:layout_height="52dp"
            android:background="#FFBBC6"
            android:gravity="center"
            android:text="公開する"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.882"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.887"
            android:layout_gravity="end"/>



    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.MyPageActivity"
    tools:layout_editor_absoluteX="0dp"
    tools:layout_editor_absoluteY="0dp">

    <include
        android:id="@+id/include"
        layout="@layout/navigation" />

    <include layout="@layout/activity_mode_bar" />


    <ImageView
        android:id="@+id/user_icon_area"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/mypage_ic_user"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.115"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.161" />

    <GridLayout
        android:id="@+id/user_information"
        android:layout_width="220dp"
        android:layout_height="100dp"
        android:columnCount="2"
        android:rowCount="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.317"
        app:layout_constraintStart_toEndOf="@+id/user_icon_area"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.161">


        <TextView
            android:id="@+id/nickname_label"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="3"
            android:layout_gravity="fill"
            android:gravity="start|center_vertical"
            android:text="ニックネーム" />

        <TextView
            android:id="@+id/nickname_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_column="1"
            android:layout_row="0"
            android:layout_columnWeight="2"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="おはよう" />

        <TextView
            android:id="@+id/answer_count_label"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="3"
            android:layout_gravity="fill"
            android:gravity="start|center_vertical"
            android:text="回答数" />

        <TextView
            android:id="@+id/answer_count_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_column="1"
            android:layout_row="1"
            android:layout_columnWeight="2"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="0" />

        <TextView
            android:id="@+id/best_answer_count_label"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_column="0"
            android:layout_row="2"
            android:layout_columnWeight="2"
            android:layout_rowWeight="1"
            android:layout_gravity="fill"
            android:gravity="start|center_vertical"
            android:text="ベストアンサー数" />

        <TextView
            android:id="@+id/best_answer_count_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_columnWeight="2"
            android:layout_gravity="fill"
            android:gravity="center"
            android:text="0" />

    </GridLayout>


    <GridLayout
        android:id="@+id/user_information_list"
        android:layout_width="340dp"
        android:layout_height="290dp"
        android:background="#E6E0E9"
        android:columnCount="3"
        android:rowCount="6"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.507"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_information"
        app:layout_constraintVertical_bias="0.221">

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnSpan="3"
            android:layout_gravity="fill_horizontal"
            android:background="@drawable/mypage_bg_cell_bottom_border"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="あなたの設定情報"
            android:textColor="#000000"
            tools:layout_editor_absoluteX="36dp"
            tools:layout_editor_absoluteY="290dp" />

        <!-- ===== 凡例行(公開 / 非公開) ===== -->
        <View
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_columnWeight="4"
            android:layout_gravity="fill_horizontal"
            android:background="@drawable/mypage_bg_cell_right_border"
            tools:layout_editor_absoluteX="36dp"
            tools:layout_editor_absoluteY="334dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnSpan="2"
            android:layout_columnWeight="6"
            android:layout_gravity="fill_horizontal"
            android:background="@drawable/mypage_bg_cell_bottom_border"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            tools:layout_editor_absoluteX="160dp"
            tools:layout_editor_absoluteY="334dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="公開"
                android:src="@drawable/ic_lock_open_off" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="公開"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="24dp"
                android:contentDescription="非公開"
                android:src="@drawable/ic_lock" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="非公開"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== 大学 ===== -->
        <TextView
            android:id="@+id/university_label"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_row="2"
            android:layout_column="0"
            android:layout_columnWeight="4"
            android:layout_gravity="fill_horizontal"
            android:background="@drawable/mypage_bg_cell_right_border"
            android:gravity="center"
            android:text="大学"
            android:textColor="#000000"
            tools:layout_editor_absoluteX="36dp"
            tools:layout_editor_absoluteY="364dp" />

        <TextView
            android:id="@+id/university_text"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_columnWeight="4"
            android:layout_gravity="fill_horizontal"
            android:gravity="center"
            android:text="香川大学"
            android:textColor="#000000"
            tools:layout_editor_absoluteX="160dp"
            tools:layout_editor_absoluteY="364dp" />

        <ImageView
            android:id="@+id/university_lock"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_row="2"
            android:layout_column="2"
            android:layout_columnWeight="2"
            android:layout_gravity="center"
            android:contentDescription="大学の公開設定"
            android:src="@drawable/ic_lock_open_off" />

        <!-- ===== 学部 ===== -->
        <TextView
            android:id="@+id/faculty_label"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_row="3"
            android:layout_column="0"
            android:layout_columnWeight="4"
            android:layout_gravity="fill_horizontal"
            android:background="@drawable/mypage_bg_cell_right_border"
            android:gravity="center"
            android:text="学部"
            android:textColor="#000000"
            tools:layout_editor_absoluteX="36dp"
            tools:layout_editor_absoluteY="418dp" />

        <TextView
            android:id="@+id/faculty_text"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_row="3"
            android:layout_column="1"
            android:layout_columnWeight="4"
            android:layout_gravity="fill_horizontal"
            android:gravity="center"
            android:text="理学部"
            android:textColor="#000000"
            tools:layout_editor_absoluteX="160dp"
            tools:layout_editor_absoluteY="418dp" />

        <ImageView
            android:id="@+id/faculty_lock"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_row="3"
            android:layout_column="2"
            android:layout_columnWeight="2"
            android:layout_gravity="center"
            android:contentDescription="学部の公開設定"
            android:src="@drawable/ic_lock_open_off" />

        <!-- ===== 学科 ===== -->
        <TextView
            android:id="@+id/department_label"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_row="4"
            android:layout_column="0"
            android:layout_columnWeight="4"
            android:layout_gravity="fill_horizontal"
            android:background="@drawable/mypage_bg_cell_right_border"
            android:gravity="center"
            android:text="学科"
            android:textColor="#000000"
            tools:layout_editor_absoluteX="36dp"
            tools:layout_editor_absoluteY="472dp" />

        <TextView
            android:id="@+id/department_text"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_row="4"
            android:layout_column="1"
            android:layout_columnWeight="4"
            android:layout_gravity="fill_horizontal"
            android:gravity="center"
            android:text="数学科"
            android:textColor="#999999"
            tools:layout_editor_absoluteX="160dp"
            tools:layout_editor_absoluteY="472dp" />

        <ImageView
            android:id="@+id/department_lock"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_row="4"
            android:layout_column="2"
            android:layout_columnWeight="2"
            android:layout_gravity="center"
            android:contentDescription="学科の公開設定"
            android:src="@drawable/ic_lock" />

        <!-- ===== 学年 ===== -->
        <TextView
            android:id="@+id/grade_label"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_row="5"
            android:layout_column="0"
            android:layout_columnWeight="4"
            android:layout_gravity="fill_horizontal"
            android:background="@drawable/mypage_bg_cell_right_border"
            android:gravity="center"
            android:text="学年"
            android:textColor="#000000"
            tools:layout_editor_absoluteX="36dp"
            tools:layout_editor_absoluteY="526dp" />

        <TextView
            android:id="@+id/grade_text"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_row="5"
            android:layout_column="1"
            android:layout_columnWeight="4"
            android:layout_gravity="fill_horizontal"
            android:gravity="center"
            android:text="3年"
            android:textColor="#999999"
            tools:layout_editor_absoluteX="160dp"
            tools:layout_editor_absoluteY="526dp" />

        <ImageView
            android:id="@+id/grade_lock"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_row="5"
            android:layout_column="2"
            android:layout_columnWeight="2"
            android:layout_gravity="center"
            android:contentDescription="学年の公開設定"
            android:src="@drawable/ic_lock" />


    </GridLayout>

    <Button
        android:id="@+id/logout_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="116dp"
        android:text="ログアウト"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.897"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gridLayout"
        app:layout_constraintVertical_bias="0.27" />


</androidx.constraintlayout.widget.ConstraintLayout>
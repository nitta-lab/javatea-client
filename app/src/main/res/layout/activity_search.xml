<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".views.SearchActivity">

    <include layout="@layout/activity_mode_bar" />
    <include layout="@layout/navigation"/>


    <TextView
        android:id="@+id/FilterLabel"
        android:layout_width="87dp"
        android:layout_height="35dp"
        android:layout_marginStart="76dp"
        android:layout_marginTop="65dp"
        android:gravity="center"
        android:text="絞り込む"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.cardview.widget.CardView
        android:id="@+id/CategoryCard"
        android:layout_width="290dp"
        android:layout_height="197dp"
        android:layout_marginTop="100dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E6E0E8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- ================================= -->
            <!-- カテゴリ表示 -->
            <!-- ================================= -->

            <TextView
                android:id="@+id/CategoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_marginStart="13dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="カテゴリ"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <!-- ================================= -->
            <!-- 全般 -->
            <!-- ================================= -->

            <Button
                android:id="@+id/CategoryButton1"
                android:layout_width="251dp"
                android:layout_height="48dp"
                android:layout_marginTop="0dp"
                android:padding="0dp"
                android:text="全般"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/CategoryLabel" />


            <!-- ================================= -->
            <!-- 甲南大学 -->
            <!-- ================================= -->

            <Button
                android:id="@+id/CategoryButton2"
                android:layout_width="251dp"
                android:layout_height="48dp"
                android:padding="0dp"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/CategoryButton1" />


            <!-- ================================= -->
            <!-- その他の大学 -->
            <!-- ================================= -->

            <Button
                android:id="@+id/CategoryButton3"
                android:layout_width="251dp"
                android:layout_height="48dp"
                android:padding="0dp"
                android:text="その他の大学"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.487"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/CategoryButton2"
                app:layout_constraintVertical_bias="0.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>


    <!-- ========================================= -->
    <!-- タグ入力の見出し -->
    <!-- ========================================= -->


    <!-- ========================================= -->
    <!-- タグ入力欄 -->
    <!-- ========================================= -->


    <!-- ========================================= -->
    <!-- タグ追加 -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/TagLabel"
        android:layout_width="290dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:background="#E6E0E8"
        android:gravity="left|center_vertical"
        android:text="     タグ名"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/CategoryCard"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/TagEditText"
        android:layout_width="184dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="#CCCCCC"
        android:hint="ここに入力してください"
        android:inputType="text"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/TagLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.735"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/CategoryCard"
        app:layout_constraintVertical_bias="1.0" />


    <!-- ========================================= -->
    <!-- 追加済みタグ：スクロール可能 -->
    <!-- ========================================= -->


    <!-- ========================================= -->
    <!-- 検索 -->
    <!-- ========================================= -->

    <Button
        android:id="@+id/AddTagButton"
        android:layout_width="76dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="60dp"
        android:backgroundTint="#6750A4"
        android:text="追加"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/TagEditText"
        app:layout_constraintVertical_bias="0.0" />

    <ScrollView
        android:id="@+id/AddedTagScrollView"
        android:layout_width="290dp"
        android:layout_height="130dp"
        android:layout_marginTop="75dp"
        android:background="#E6E0E8"
        android:fillViewport="false"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/TagLabel"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:id="@+id/AddedTagText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:orientation="vertical"
            android:padding="10dp">

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/SearchButton"
        android:layout_width="76dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="44dp"
        android:backgroundTint="#6750A4"
        android:text="検索"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/AddedTagScrollView"
        app:layout_constraintVertical_bias="0.077" />
</androidx.constraintlayout.widget.ConstraintLayout>